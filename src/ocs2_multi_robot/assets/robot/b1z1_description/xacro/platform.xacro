<?xml version="1.0"?>

<robot name="platform_description" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Define properties -->
  <xacro:property name="box_mass" value="1"/>
  <xacro:property name="box_size" value="1"/>
  <xacro:property name="plate_height" value="0.1"/>

  <!-- World Link (fixed reference frame) -->
  <link name="world"/>

  <!-- Platform Link -->
  <link name="platform_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${box_size} ${box_size} ${plate_height}"/>
      </geometry>
      <material name="platform_material">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${box_size} ${box_size} ${plate_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${box_mass}"/>
      <inertia
        ixx="${(box_mass/12.0) * (box_size*box_size + plate_height*plate_height)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${(box_mass/12.0) * (box_size*box_size + plate_height*plate_height)}"
        iyz="0.0"
        izz="${(box_mass/12.0) * (box_size*box_size + box_size*box_size)}"/>
    </inertial>
  </link>

  <!-- Fixed joint to ground the platform -->
  <joint name="platform_to_world" type="fixed">
    <parent link="world"/>
    <child link="platform_base"/>
    <origin xyz="0 0 ${plate_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo material properties -->
  <gazebo reference="platform_base">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

</robot>