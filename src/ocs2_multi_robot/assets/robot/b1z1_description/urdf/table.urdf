<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    Dining table (Sutherland Arlette 305) for dual robot cooperative manipulation | -->
<!-- |    Mesh: table.obj (Blender Y-up, rotated 90° around X for ROS Z-up)            | -->
<!-- |    Actual size: ~3.05m (L) x 1.07m (W) x 0.74m (H)                             | -->
<!-- |    Origin at center of tabletop top surface                                      | -->
<!-- =================================================================================== -->
<robot name="table_description">
  <!-- Material definition (RViz only, Gazebo uses OBJ/MTL textures) -->
  <material name="wood_brown">
    <color rgba="0.55 0.35 0.17 1.0"/>
  </material>

  <!-- Table link -->
  <!-- Origin at center of tabletop top surface -->
  <link name="table">
    <inertial>
      <mass value="5.0"/>
      <origin rpy="0 0 0" xyz="0 0 -0.37"/>
      <inertia ixx="0.705" ixy="0.0" ixz="0.0" iyy="4.104" iyz="0.0" izz="4.353"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://ocs2_multi_robot/assets/robot/b1z1_description/meshes/table.obj"/>
      </geometry>
      <origin rpy="1.5708 0 0" xyz="0 0 -0.74"/>
      <material name="wood_brown"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ocs2_multi_robot/assets/robot/b1z1_description/meshes/table.obj"/>
      </geometry>
      <origin rpy="1.5708 0 0" xyz="0 0 -0.74"/>
    </collision>
  </link>

  <!-- IMU sensor link -->
  <joint name="imu_joint" type="fixed">
    <parent link="table"/>
    <child link="table_imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.025"/>
  </joint>
  <link name="table_imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="table_imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <visualize>true</visualize>
      <topic>__default_topic__</topic>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <topicName>cargo_imu</topicName>
        <bodyName>imu_link</bodyName>
        <updateRateHZ>1000.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>imu_link</frameName>
      </plugin>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

</robot>
