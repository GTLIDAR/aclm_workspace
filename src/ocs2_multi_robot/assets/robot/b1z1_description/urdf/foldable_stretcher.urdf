<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    Foldable stretcher for four-robot cooperative manipulation                    | -->
<!-- |    Mesh: foldable_stretcher.stl (scaled 0.01), origin at center                  | -->
<!-- |    Scaled size: ~2.05m (Z-long) x 0.57m (X-wide) x 0.17m (Y-tall)               | -->
<!-- =================================================================================== -->
<robot name="stretcher_description">
  <material name="stretcher_gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- Stretcher link -->
  <link name="stretcher">
    <inertial>
      <mass value="5.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1.76" ixy="0.0" ixz="0.0" iyy="1.89" iyz="0.0" izz="0.15"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://ocs2_multi_robot/assets/robot/b1z1_description/meshes/foldable_stretcher.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="stretcher_gray"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ocs2_multi_robot/assets/robot/b1z1_description/meshes/foldable_stretcher.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
  </link>

  <!-- IMU sensor link -->
  <joint name="imu_joint" type="fixed">
    <parent link="stretcher"/>
    <child link="stretcher_imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="stretcher_imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="stretcher_imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <visualize>true</visualize>
      <topic>__default_topic__</topic>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <topicName>cargo_imu</topicName>
        <bodyName>imu_link</bodyName>
        <updateRateHZ>1000.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>imu_link</frameName>
      </plugin>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

</robot>
