Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF1/Frames1
        - /RobotModel3/Links1
        - /Box1
      Splitter Ratio: 0.5
    Tree Height: 719
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: ""
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /cen_opt/centroid
      Name: Centroid
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /cen_opt/currentState
      Name: Current State
      Namespaces:
        Arm EE Forces: true
        Arm EE Positions: true
        EE Forces: true
        EE Positions: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /cen_opt/terrain
      Name: Terrain
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /cen_opt/optimizedStateTrajectory
      Name: Optimized Trajectory
      Namespaces:
        Cargo_End: true
        Cargo_Trajectory: true
        Robot1_CoM_Trajectory: true
        Robot1_EE_Trajectory_FL: true
        Robot1_EE_Trajectory_FR: true
        Robot1_EE_Trajectory_RL: true
        Robot1_EE_Trajectory_RR: true
        Robot1_Future_footholds: true
        Robot2_CoM_Trajectory: true
        Robot2_EE_Trajectory_FL: true
        Robot2_EE_Trajectory_FR: true
        Robot2_EE_Trajectory_RL: true
        Robot2_EE_Trajectory_RR: true
        Robot2_Future_footholds: true
        Robot3_CoM_Trajectory: true
        Robot3_EE_Trajectory_FL: true
        Robot3_EE_Trajectory_FR: true
        Robot3_EE_Trajectory_RL: true
        Robot3_EE_Trajectory_RR: true
        Robot3_Future_footholds: true
        Robot4_CoM_Trajectory: true
        Robot4_EE_Trajectory_FL: true
        Robot4_EE_Trajectory_FR: true
        Robot4_EE_Trajectory_RL: true
        Robot4_EE_Trajectory_RR: true
        Robot4_Future_footholds: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /cen_opt/predicted_footholds
      Name: Foothold Visualization
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /cen_opt/constraint_polygons
      Name: Constraint Polygons
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /obstacle_markers
      Name: Obstacles
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 136; 138; 133
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: ObstacleCourse
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.009999999776482582
      Style: Points
      Topic: /points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /convex_plane_decomposition_ros/boundaries
      Name: PlanarRegionBoundaries
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /convex_plane_decomposition_ros/insets
      Name: PlanarRegionInsets
      Namespaces:
        "": true
      Queue Size: 100
      Value: true
    - Alpha: 0.5
      Autocompute Intensity Bounds: false
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: elevation
      Color Transformer: None
      ColorMap: default
      Enabled: true
      Grid Cell Decimation: 1
      Grid Line Thickness: 0.05000000074505806
      Height Layer: elevation
      Height Transformer: Layer
      History Length: 1
      Invert ColorMap: false
      Max Color: 255; 255; 255
      Max Intensity: 0.15000000596046448
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Elevation Map
      Show Grid Lines: true
      Topic: /elevation_mapping/elevation_map
      Unreliable: false
      Use ColorMap: true
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /robot1/cen_opt/desiredBaseTrajectory
      Name: Robot1 Base Trajectory
      Namespaces:
        "": true
      Queue Size: 100
      Value: true
