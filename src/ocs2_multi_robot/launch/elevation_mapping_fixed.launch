<launch>
  <arg name="world_name" />
  <arg name="map_frame" default="odom" />
  <arg name="base_frame" default="cargo" />
  <arg name="target_frame" default="odom" />
  <arg name="elevation_config" default="$(find ocs2_multi_robot)/config/yaml/elevation_mapping_fixed.yaml" />

  <!-- Publish obstacle course point cloud from PLY file -->
  <node pkg="point_cloud_io" type="read" name="read_ply" output="screen">
    <param name="file_path"
      value="$(find ocs2_multi_robot)/assets/terrain/point_cloud/$(arg world_name).ply" />
    <param name="topic" value="/points" />
    <param name="frame" value="$(arg map_frame)" />
    <param name="rate" value="1.0" />
  </node>

  <node pkg="elevation_mapping" type="elevation_mapping" name="elevation_mapping" output="screen">
    <rosparam command="load" file="$(arg elevation_config)" />
    <!-- Override frame settings from yaml -->
    <param name="map_frame_id" value="$(arg map_frame)" />
    <param name="robot_base_frame_id" value="$(arg base_frame)" />
    <param name="track_point_frame_id" value="$(arg base_frame)" />

    <rosparam command="load"
      file="$(find ocs2_multi_robot)/config/yaml/postprocessor_pipeline.yaml" />
  </node>

  <!-- Convex Plane Decomposition (extracts planar regions from elevation map) -->
  <node pkg="convex_plane_decomposition_ros" type="convex_plane_decomposition_ros_node"
    name="convex_plane_decomposition_ros" output="screen">
    <rosparam file="$(find ocs2_multi_robot)/config/yaml/convex_plane_decomposition.yaml"
      command="load" />
    <rosparam file="$(find ocs2_multi_robot)/config/yaml/convex_plane_decomposition_node.yaml"
      command="load" />

    <param name="target_frame_id" value="$(arg target_frame)" />
  </node>
</launch>