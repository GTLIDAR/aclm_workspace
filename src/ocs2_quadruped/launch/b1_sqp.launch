<?xml version="1.0" ?>

<launch>
    <!-- visualization config -->
    <arg name="rviz"               default="true" />
    <arg name="description_name"   default="robot_description"/>
    <arg name="multiplot"          default="false"/>

    <!-- The task file for the mpc. -->
    <arg name="taskFile"          default="$(find ocs2_quadruped)/config/mpc/task_b1.info"/>
    <!-- The reference related config file of the robot -->
    <arg name="referenceFile"     default="$(find ocs2_quadruped)/config/command/reference_b1.info"/>
    <!-- The URDF model of the robot -->
    <arg name="urdfFile"          default="$(find ocs2_multi_robot)/assets/robot/b1_description/urdf/b1.urdf"/>
    <!-- The file defining gait definition -->
    <arg name="gaitCommandFile"   default="$(find ocs2_quadruped)/config/command/gait.info"/>

    <!-- rviz -->
    <group if="$(arg rviz)">
      <param name="$(arg description_name)" textfile="$(arg urdfFile)"/>
      <arg name="rvizconfig" default="$(find ocs2_quadruped)/rviz/b1.rviz" />
      <node pkg="rviz" type="rviz" name="rviz" args="-d $(arg rvizconfig)" output="screen" />
    </group>

    <!-- multiplot -->
    <group if="$(arg multiplot)">
      <include file="$(find ocs2_quadruped)/launch/multiplot.launch"/>
    </group>

    <!-- make the files into global parameters -->
    <param name="taskFile"          value="$(arg taskFile)" />
    <param name="referenceFile"     value="$(arg referenceFile)" />
    <param name="urdfFile"          value="$(arg urdfFile)" />
    <param name="gaitCommandFile"   value="$(arg gaitCommandFile)"/>

    <node pkg="ocs2_quadruped" type="legged_robot_sqp_mpc_raw" name="legged_robot_sqp_mpc_raw"
          output="screen" launch-prefix=""/>

    <node pkg="ocs2_quadruped" type="legged_robot_dummy_raw" name="legged_robot_dummy_raw"
          output="screen" launch-prefix="gnome-terminal --"/>

    <!-- <node pkg="ocs2_quadruped" type="legged_robot_target" name="legged_robot_target"
          output="screen" launch-prefix="gnome-terminal "/> -->

    <node pkg="ocs2_quadruped" type="legged_target_trajectories_publisher" name="legged_robot_target"
          output="screen"/>

    <node pkg="ocs2_quadruped" type="legged_robot_gait_command" name="legged_robot_gait_command"
          output="screen" launch-prefix="gnome-terminal --"/>

    <!-- <node pkg="ocs2_quadruped" type="torque_compute" name="torque_compute"
          output="screen"/> -->
</launch>
